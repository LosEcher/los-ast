NODE_ENV=development
PORT=3000

# Scan limits
MAX_FILES_PER_SYNC_SCAN=1000
MAX_RESPONSE_BYTES=10485760
MAX_SCAN_DURATION_MS=30000

# Scope and identity
REQUIRE_FULL_SCOPE=false
ENFORCE_JWT=false
JWT_SECRET=
LSCLAW_JWT_SECRET=
DEV_ALLOW_UNVERIFIED_IDENTITY=false

# Evidence
EVIDENCE_SIGNING_KEY=

# Experimental persistence
EXPERIMENTAL_STORE_BACKEND=memory
EXPERIMENTAL_STORE_DIR=
EXPERIMENTAL_SQLITE_PATH=

# Native artifact parsers
ENABLE_OPENAPI_NATIVE_PARSER=true
ENABLE_SCHEMA_NATIVE_PARSER=true

# Route flags
ENABLE_EXPERIMENTAL_ROUTES=false
ENABLE_INTERNAL_ROUTES=false
ENABLE_VPS_AGENT_WEB_ROUTES=false

# Route prefixes
ROUTE_PREFIX_EXPERIMENTAL=/experimental
ROUTE_PREFIX_INTERNAL=/internal
ROUTE_PREFIX_VPS_AGENT_WEB=/vps-agent-web

# Internal route access control
INTERNAL_ROUTES_ALLOWED_IPS=127.0.0.1,localhost
INTERNAL_ROUTES_TOKEN=
INTERNAL_ROUTES_ALLOW_LOCALHOST=true
