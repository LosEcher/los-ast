{
  "name": "@los-ast/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "benchmark:scan": "tsx scripts/scan-benchmark.ts",
    "generate:scan-contract-reference": "tsx scripts/generate-scan-contract-reference.ts",
    "check:scan-contract-reference": "tsx scripts/generate-scan-contract-reference.ts --check",
    "generate:scan-openapi-components": "tsx scripts/sync-scan-openapi-components.ts",
    "check:scan-openapi-components": "tsx scripts/sync-scan-openapi-components.ts --check",
    "generate:scan-api-contract-sections": "tsx scripts/sync-scan-api-contract-sections.ts",
    "check:scan-api-contract-sections": "tsx scripts/sync-scan-api-contract-sections.ts --check",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@los-ast/core": "file:../core",
    "@los-ast/rules": "file:../rules",
    "@los-ast/shared": "file:../shared",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "fastify": "^5.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
