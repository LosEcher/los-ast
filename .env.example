# los-ast API 服务环境变量配置
# 复制此文件为 .env 并根据需要修改

# ============================================
# 服务器配置
# ============================================

# 服务端口 (默认: 3000)
PORT=3000

# 运行环境: development | production
NODE_ENV=development

# ============================================
# 扫描限制配置 (硬约束 #4)
# ============================================

# 单次同步扫描最大文件数 (默认: 1000)
MAX_FILES_PER_SYNC_SCAN=1000

# 最大响应字节数 (默认: 10485760 = 10MB)
MAX_RESPONSE_BYTES=10485760

# 最大扫描持续时间，单位毫秒 (默认: 30000 = 30秒)
MAX_SCAN_DURATION_MS=30000

# ============================================
# Scope 验证配置 (硬约束 #3)
# ============================================

# 生产环境强制要求完整 scope (默认: false, 生产环境自动为 true)
# 设置为 true 时，所有请求必须包含 tenant_id, project_id, actor_id
REQUIRE_FULL_SCOPE=false

# ============================================
# 日志配置
# ============================================

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# 开发环境专用
# ============================================

# 启用实验性路由 (Phase 1.x 功能)
# 实验性路由挂载在 /experimental/* 下
# 包含: memory-proposals, incidents, attribution, recovery, approvals, hotreload, evidence
# 生产环境建议关闭，仅启用 P0 核心路由
ENABLE_EXPERIMENTAL_ROUTES=false

# 启用内部路由 (开发/调试用途)
# 内部路由挂载在 /internal/* 下
# 仅建议在开发环境启用
ENABLE_INTERNAL_ROUTES=false

# 启用 VPS Agent Web 集成路由
# 路由挂载在 /vps-agent-web/* 下
# 用于对外稳定前缀联调，默认关闭
ENABLE_VPS_AGENT_WEB_ROUTES=false

# --------------------------------------------
# 内部路由访问控制配置 (ENABLE_INTERNAL_ROUTES=true 时生效)
# --------------------------------------------

# 允许的 IP 地址列表，逗号分隔
# 示例: 192.168.1.100,10.0.0.50
INTERNAL_ROUTES_ALLOWED_IPS=

# 内部访问 Token (Bearer 认证)
# 生成方式: openssl rand -base64 64
INTERNAL_ROUTES_TOKEN=

# 是否允许本地访问 (默认: true)
# 设置为 false 时，即使是本地请求也需要 Token
INTERNAL_ROUTES_ALLOW_LOCALHOST=true
